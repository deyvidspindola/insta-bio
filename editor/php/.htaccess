# Links na Bio — editor do cliente (/{slug}/editor/)
Options -Indexes -MultiViews

# Impede que arquivos de configuração sejam baixados
<FilesMatch "^(auth\.config|auth\.config\.example)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical (evita loop com rewrite interno)
  RewriteCond %{THE_REQUEST} \s/preview\.html[\s?] [NC]
  RewriteRule ^preview\.html$ preview [R=301,L,NC]

  # API amigável → PHP
  RewriteRule ^api/auth/session$ session.php [L,QSA]
  RewriteRule ^api/auth/platform-config$ platform-config.php [L,QSA]
  RewriteRule ^api/auth/login$ login.php [L,QSA]
  RewriteRule ^api/auth/establish$ establish-session.php [L,QSA]
  RewriteRule ^api/auth/logout$ logout.php [L,QSA]
  RewriteRule ^api/bio/save$ save.php [L,QSA]
  RewriteRule ^api/bio/publish$ publish.php [L,QSA]
  RewriteRule ^api/bio/revert$ revert.php [L,QSA]
  RewriteRule ^api/bio/load$ load.php [L,QSA]
  RewriteRule ^api/bio/paths$ paths.php [L,QSA]
  RewriteRule ^api/assets/upload$ upload.php [L,QSA]
  RewriteRule ^api/assets/list$ list-images.php [L,QSA]
  RewriteRule ^api/assets/delete$ delete-image.php [L,QSA]

  RewriteRule ^preview/?$ preview.html [L,NC]

  # Arquivos reais
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # SPA do editor
  RewriteRule ^ index.html [L]
</IfModule>
